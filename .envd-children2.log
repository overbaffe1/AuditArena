'http' or d['dir']!='out': continue\n    peers[d['peer'].split(':')[0]]+=1\n    f=d['first']\n    if 'Filesystem/Stat' in f: pass\n    elif f.startswith('GET /files'):\n        gt[urllib.parse.unquote(f.split('path=')[1].split(' ')[0]).split('/')[-1]]+=1\nfor d in rows:\n    if d.get('event')=='body':\n        b=d['body_red']; k=b.find('{')\n        if k<0 or k>8: continue\n        try: j=json.loads(b[k:])\n        except Exception: continue\n        if isinstance(j,dict) and list(j.keys())==['path']:\n            st[j['path'].split('/')[-1]]+=1\nprint(' Stat:',dict(st.most_common(8)))\nprint(' GET :',dict(gt.most_common(8)))\nprint(' пиры:',dict(peers))\nPY"}, {"dt_ms": 4.5, "len": 2326, "text": "/bin/bash -l -c cd /home/user/AuditArena && git rm -q --cached .github/workflows/arena-probe17.yml 2>/dev/null; rm -rf .github; python3 - <<'PY'\nimport json,collections,urllib.parse\nrows=[]\nfor line in open('.envd-wire17.log',encoding='utf-8',errors='replace'):\n    line=line.strip()\n    if not line: continue\n    try: rows.append(json.loads(line))\n    except Exception: pass\nprint('записей:',len(rows),'окно:',rows[0].get('utc'),'→',rows[-1].get('utc'))\nprint()\nprint('=== /init ===')\nfor i,d in enumerate(rows):\n    if d.get('event')=='http' and d['first'].startswith('POST /init'):\n        print(' ',d['utc'],d['peer'],'token:',d.get('token',{}).get('sha512_12'),d.get('token',{}).get('len'))\n        for e in rows[i+1:i+4]:\n            if e.get('event')=='body':\n                b=e['body_red']; j=None\n                k=b.find('{')\n                try: j=json.loads(b[k:])\n                except Exception: pass\n                if j:\n                    print('   body keys:',sorted(j.keys()))\n                    for key in ('envVars','envs','defaultUser','username','workdir','cwd','accessToken'):\n                        if key in j:\n                            v=j[key]\n                            print(f'   {key}:', sorted(v.keys()) if isinstance(v,dict) el