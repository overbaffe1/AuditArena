{"event": "cmdline_new", "id": 192, "cmd": "/bin/bash -l -c cd /home/user/AuditArena && mkdir -p artifacts/round16 && cp /tmp/envd-wire16.log artifacts/round16/envd-wire16.log && cp /tmp/fanotify16.log artifacts/round16/fanotify16.log && TOKH=$(TOK=$(curl -s -m 3 -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 5'); curl -s -m 3 -H \"X-aws-ec2-metadata-token: $TOK\" http://169.254.169.254/accessTokenHash) && python3 - \"$TOKH\" <<'PY'\nimport json,sys,collections\nmmds=sys.argv[1].strip()\nrows=[]\nfor line in open('artifacts/round16/envd-wire16.log',encoding='utf-8',errors='replace'):\n    line=line.strip()\n    if not line: continue\n    try: rows.append(json.loads(line))\n    except Exception: pass\nhttp=[d for d in rows if d['event']=='http']\nprint('всего записей:',len(rows),' http:',len(http))\nuas=collections.Counter(); hosts=collections.Counter(); peers=collections.Counter()\ntoks={}\nfor d in http:\n    uas[d['headers'].get('user-agent','<нет>')]+=1\n    hosts[d['headers'].get('host','<нет>')]+=1\n    peers[d['peer'].split(':')[0]]+=1\n    for key in ('token','auth'):\n        if key in d: toks.setdefault(key,set()).add(json.dumps(d[key],sort_keys=True))\nprint('User-Agent:',dict(uas))\nprint('Host:',dict(hosts))\nprint('IP-пиры:',dict(peers))\nprint('отпечатки токенов:')\nfor key,vals in toks.items():\n    for v in vals:\n        t=json.loads(v)\n        match='СОВПАДАЕТ с MMDS accessTokenHash' if t.get('sha512_12')==mmds[:12] else 'не совпадает с MMDS'\n        print(f'  {key}: len={t[\"len\"]} prefix4={t[\"prefix4\"]} sha512_12={t[\"sha512_12\"]} → {match}')\nprint()\nprint('=== хронология ЗАПРОСОВ (dir=out) ===')\nfor d in http:\n    if d['dir']!='out': continue\n    first=d['first']\n    if len(first)>150: first=first[:150]+'…'\n    print(f\"{d['utc']} {first} body={d.get('body_skip')} tok={'+' if 'token' in d else '-'}\")\nPY", "rev": 6, "t_real": 1792265803.845489, "t_mono": 3478.763192, "utc": "19:36:43.845"}
