{"event": "cmdline_new", "id": 195, "cmd": "/bin/bash -l -c cd /home/user/AuditArena && python3 - <<'PY'\nimport json,collections,re\nrows=[json.loads(l) for l in open('artifacts/round16/envd-wire16.log',encoding='utf-8',errors='replace') if l.strip()]\nhttp=[d for d in rows if d['event']=='http' and d['dir']=='out']\nxt=collections.Counter()\nfor d in http:\n    path=d['first'].split(' ')[1].split('?')[0]\n    if path=='/files': path='/files<path>'\n    xt[(d['headers'].get('user-agent','<нет>'),path)]+=1\nprint('=== клиент × RPC ===')\nfor (ua,path),n in sorted(xt.items()):\n    print(f'  {ua:22s} {path:34s} {n}')\nprint()\nprint('=== полные заголовки: первый POST /files и первый GET /files ===')\nseen=set()\nfor d in http:\n    p=d['first'].split(' ')[1]\n    key=(d['first'].split(' ')[0], '/files' if p.startswith('/files') else p)\n    if key in seen or not p.startswith('/files'): continue\n    seen.add(key)\n    rec={k:v for k,v in d.items() if k!='t_real'}\n    print(json.dumps(rec,ensure_ascii=False,indent=1)[:900]); print()\n    if len(seen)==2: break\nprint('=== fanotify: кто открывает ===')\nfan=[json.loads(l) for l in open('artifacts/round16/fanotify16.log',encoding='utf-8',errors='replace') if l.strip()]\ngrp=collections.Counter()\nfor d in fan:\n    if d['event']!='open': continue\n    grp[(d['pid'],d['uid'],d['path'],d['mask'])]+=1\nfor k,n in sorted(grp.items(), key=lambda x:-x[1])[:18]:\n    print(f'  pid={k[0]} uid={k[1]} {k[3]:24s} {k[2]} x{n}')\nprint()\nprint('=== открытия /opt/canary16.txt (резервное чтение) ===')\nfor d in fan:\n    if d.get('path')=='/opt/canary16.txt':\n        print(f\"  {d['utc']} pid={d['pid']} uid={d['uid']} {d['mask']} cmd={d['cmd'][:40]!r}\")\nprint('=== открытия /tmp/arena-workspace (30-сек опрос) ===')\nn=0\nfor d in fan:\n    if d.get('path')=='/tmp/arena-workspace':\n        print(f\"  {d['utc']} pid={d['pid']} uid={d['uid']} {d['mask']} cmd={d['cmd'][:40]!r}\"); n+=1\n        if n>=6: break\nPY", "rev": 6, "t_real": 1792265886.725236, "t_mono": 3561.642938, "utc": "19:38:06.725"}
