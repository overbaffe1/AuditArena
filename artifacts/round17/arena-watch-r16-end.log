{"event": "cmdline_new", "id": 196, "cmd": "/bin/bash -l -c cd /home/user/AuditArena && sudo -n python3 - <<'PY'\nimport ctypes,ctypes.util,os,struct,select,time\nlibc=ctypes.CDLL(ctypes.util.find_library('c') or 'libc.so.6',use_errno=True)\nfd=libc.fanotify_init(0|1|2, os.O_RDONLY)\nprint('init fd=',fd, 'errno=',ctypes.get_errno())\nrc=libc.fanotify_mark(fd,1,0x20|0x18,-100,b'/opt')\nprint('mark /opt rc=',rc,'errno=',ctypes.get_errno())\n# контрольное открытие тем же процессом\nf=open('/opt/canary16.txt','rb'); f.read(); f.close()\nos.system('cat /opt/canary16.txt >/dev/null')\ntime.sleep(0.3)\np=select.poll(); p.register(fd,select.POLLIN)\nn=0\nwhile p.poll(300) and n<8:\n    data=os.read(fd,65536); off=0\n    while off+16<=len(data):\n        el,vers,res,mask,evfd,pid=struct.unpack_from('<IBBHii',data,off)\n        path=None\n        if evfd>=0:\n            try: path=os.readlink('/proc/self/fd/%d'%evfd)\n            except Exception: pass\n            os.close(evfd)\n        print('  событие: pid=%d mask=%#x path=%s'%(pid,mask,path)); n+=1\n        off+=el\nprint('контрольных событий:',n)\nPY\necho \"=== inotify наблюдателя: опросы /tmp/arena-workspace в этом раунде ===\" && python3 - <<'PY'\nimport json\nn=0\nfor line in open('.arena-watch-rev6.log',encoding='utf-8',errors='replace'):\n    line=line.strip()\n    if not line: continue\n    try: d=json.loads(line)\n    except Exception: continue\n    if d.get('event')!='reads' or d.get('t_real',0)<1792265700: continue\n    tops=[t['path'] for t in d.get('top',[])[:2]]\n    if any('arena-workspace' in t or 'procs' in t for t in tops):\n        n+=1\n        if n<=8: print(f\"{d['utc']} total={d['total']} :: {[t.replace('/tmp/arena-workspace','WS').replace('/home/user/','') for t in tops]}\")\nprint('всего таких reads-окон:',n)\nPY", "rev": 6, "t_real": 1792265976.267231, "t_mono": 3651.184932, "utc": "19:39:36.267"}
