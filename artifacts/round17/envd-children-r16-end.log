{"event": "child_done", "pid": 2617, "life_ms": 25.68, "ids": {"uid": "1001", "gid": "1001", "ppid": "1229"}, "distinct": 2, "cmdlines": [{"dt_ms": 0.0, "len": 2963, "text": "/bin/sh -c echo 100 > /proc/$$/oom_score_adj && exec /usr/bin/ionice -c 2 -n 4 /usr/bin/nice -n 20 \"${@}\" -- /bin/bash -l -c python3 -I - <<'PY'\nimport base64\nimport codecs\nimport json\nimport os\nimport stat as stat_module\nimport sys\n\npath = \"/home/user/AuditArena/investigation-round15.md\"\noffset = None\nlimit = 4\nmax_bytes = 262144\nhalf = max_bytes // 2\n\ndef emit(value):\n    sys.stdout.write(json.dumps(value, separators=(\",\", \":\")))\n    sys.stdout.flush()\n    sys.exit(0)\n\ntry:\n    if not stat_module.S_ISREG(os.stat(path).st_mode):\n        emit({\"status\": \"open_error\"})\n    source = open(path, \"rb\")\nexcept OSError:\n    emit({\"status\": \"open_error\"})\n\nstart = 0 if offset is None else offset - 1\nend = None if limit is None else start + limit\ndecoder = codecs.getincrementaldecoder(\"utf-8\")(\"strict\")\nsize = 0\nnewlines = 0\n# The newlines before and inside the selection, and the selection state: 0 before, 1 inside, 2 after.\nseen = 0\nstate = 1 if start == 0 else 0\nselected = 0\nhead = bytearray()\ntail = bytearray()\n\ndef take(data):\n    global selected\n    selected += len(data)\n    if len(head) <= max_bytes:\n        head.extend(data[: max_bytes + 1 - len(head)])\n    if half > 0:\n        tail.extend(data[-half:])\n        if len(tail) > half:\n            del tail[: len(tail) - half]\n\ndef end_of_newline(data, index, count):\n    for _ in range(count):\n        index = data.index(b\"\\n\", index) + 1\n    return index\n\nwith source:\n    first = True\n    while True:\n        data = source.read(1024 * 1024)\n        if not data:\n            break\n        if first:\n            first = False\n            if data.startswith(b\"\\xef\\xbb\\xbf\"):\n                data = data[3:]\n        try:\n            decoder.decode(data)\n        except UnicodeDecodeError:\n            emit({\"status\": \"invalid_utf8\"})\n        size += len(data)\n        newlines += data.count(b\"\\n\")\n        index = 0\n        if state == 0:\n            found = data.count(b\"\\n\")\n            if found < start - seen:\n                seen += found\n                continue\n            index = end_of_newline(data, 0, start - seen)\n            seen = start\n            state = 1\n        if state == 1:\n            found = data.count(b\"\\n\", index)\n            if end is None or found < end - seen:\n                take(data[index:])\n                seen += found\n            else:\n                stop = end_of_newline(data, index, end - seen)\n                take(data[index : stop - 1])\n                state = 2\n\ntry:\n    decoder.decode(b\"\", True)\nexcept UnicodeDecodeError:\n    emit({\"status\": \"invalid_utf8\"})\n\ndef b64(data):\n    return base64.b64encode(bytes(data)).decode(\"ascii\")\n\nif selected <= max_bytes:\n    emit({\"status\": \"whole\", \"size\": size, \"lines\": newlines + 1, \"text\": b64(head)})\nemit(\n    {\n        \"status\": \"elided\",\n        \"size\": size,\n        \"lines\": newlines + 1,\n        \"selectedBytes\": selected,\n        \"head\": b64(head[: half + 1]),\n        \"tail\": b64(tail),\n    }\n)\nPY"}, {"dt_ms": 3.8, "len": 2854, "text": "/bin/bash -l -c python3 -I - <<'PY'\nimport base64\nimport codecs\nimport json\nimport os\nimport stat as stat_module\nimport sys\n\npath = \"/home/user/AuditArena/investigation-round15.md\"\noffset = None\nlimit = 4\nmax_bytes = 262144\nhalf = max_bytes // 2\n\ndef emit(value):\n    sys.stdout.write(json.dumps(value, separators=(\",\", \":\")))\n    sys.stdout.flush()\n    sys.exit(0)\n\ntry:\n    if not stat_module.S_ISREG(os.stat(path).st_mode):\n        emit({\"status\": \"open_error\"})\n    source = open(path, \"rb\")\nexcept OSError:\n    emit({\"status\": \"open_error\"})\n\nstart = 0 if offset is None else offset - 1\nend